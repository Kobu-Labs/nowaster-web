{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT h.id, h.label, h.usage_count, h.created_at as \"created_at: DateTime<Utc>\"\n                FROM hint h\n                JOIN category_hint ch ON ch.hint_id = h.id\n                WHERE ch.category_id = $1 AND ch.user_id = $2\n                ORDER BY h.label ASC\n                ",
